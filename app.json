{
  "expo": {
    "name": "Hear!",
    "slug": "hear-listener",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hear-icon.png",
    "scheme": "hear-listener",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.samuedev33.hearlistener",
      "usesAppleSignIn": true,
      "icon": "./assets/images/hear-icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Hear! to turn your voice command into text.",
        "NSMicrophoneUsageDescription": "Allow Hear! to use the microphone when you start a voice command."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EC",
        "foregroundImage": "./assets/images/hear-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.samuedev33.hearlistener"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/hear-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#271136",
          "image": "./assets/images/splash-logo-brand.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#271136",
            "image": "./assets/images/splash-logo-brand.png",
            "imageWidth": 300
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hear! to use your approximate location to suggest local audio."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Hear! to use the microphone when you start a voice command.",
          "speechRecognitionPermission": "Allow Hear! to turn your voice command into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as",
            "com.iflytek.speechservice"
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-audio",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/hear-icon.png",
          "color": "#7B3068"
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eea65ded-45c2-4051-960c-4a727ca41597"
      }
    }
  }
}
