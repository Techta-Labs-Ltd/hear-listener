{
  "expo": {
    "name": "Hear!",
    "slug": "hear-listener",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hear-icon.png",
    "scheme": "hear-listener",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.samuedev33.hearlistener",
      "usesAppleSignIn": true,
      "icon": "./assets/images/hear-icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Hear! uses Apple speech recognition to understand your voice commands.",
        "NSMicrophoneUsageDescription": "Hear! uses the microphone so you can control the app and find audio using your voice.",
        "NSMotionUsageDescription": "Allow Hear! to access motion sensors for accessible spatial gesture navigation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EC",
        "foregroundImage": "./assets/images/hear-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "package": "com.samuedev33.hearlistener"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/hear-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#271136",
          "image": "./assets/images/splash-logo-brand.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#271136",
            "image": "./assets/images/splash-logo-brand.png",
            "imageWidth": 300
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hear! to use your approximate location to suggest local audio."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hear! uses the microphone so you can control the app and find audio using your voice.",
          "speechRecognitionPermission": "Hear! uses speech recognition to understand your voice commands.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-audio",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/hear-icon.png",
          "color": "#7B3068"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Hear! to access motion sensors for accessible spatial gesture navigation."
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eea65ded-45c2-4051-960c-4a727ca41597"
      }
    }
  }
}
